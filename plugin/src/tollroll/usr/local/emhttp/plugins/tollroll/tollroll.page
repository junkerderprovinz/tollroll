            </div>
          </div>
          <div class="trs-row">
            <div class="trs-lbl"><span class="trs-name-i"><label class="trs-name" for="trs-m-on"><?=$h('s_mute')?></label><?=$trs_info('s_mute_hint')?></span></div>
            <div class="trs-ctl">
