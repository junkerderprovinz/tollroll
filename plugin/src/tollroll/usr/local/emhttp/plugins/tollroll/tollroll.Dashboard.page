Menu="Dashboard:0"
Cond="version_compare(parse_ini_file('/etc/unraid-version')['version'],'6.11.9','>')"
---
<?php
/* TollRoll: a native Unraid dashboard tile, listed in tile management like
 * the built-in ones.
 *
 * - The ":0" rank in Menu="Dashboard:0" sorts this page before DashStats,
 *   which builds the tile table; without it the tile is silently dropped.
 * - The <tbody title> is the tile's identity: tile management shows it, and
 *   md5(title) keys the visibility and position saved in
 *   /boot/config/dashboard_settings.json. It stays English for that reason.
 * - This page runs on every dashboard load, so it stays a static frame with
 *   no functions (a .page can be included twice) and no network call.
 *   scripts/tile.js fills it from the same-origin proxy.
 * - The first row copies DashStats' header structure, which Unraid's
 *   dashboard JS hooks the collapse chevron and dragging onto.
 */
$trl_locale = (string)(isset($_SESSION['locale']) ? $_SESSION['locale'] : '');
$trl_lang   = strtolower(substr($trl_locale, 0, 2));
$trl_dir    = '/usr/local/emhttp/plugins/tollroll/lang';
$trl_L      = json_decode(@file_get_contents("$trl_dir/en.json"), true) ?: array();
if (preg_match('/^[a-z]{2}$/', $trl_lang) && $trl_lang !== 'en' && is_file("$trl_dir/$trl_lang.json")) {
  $trl_tr = json_decode(@file_get_contents("$trl_dir/$trl_lang.json"), true);
  if (is_array($trl_tr)) $trl_L = array_merge($trl_L, $trl_tr);
}
$trl_js = array();
foreach ($trl_L as $trl_k => $trl_v) {
  if (strncmp($trl_k, 's_', 2) !== 0) $trl_js[$trl_k] = $trl_v;
}
$trl_settings = htmlspecialchars($trl_L['t_settings'], ENT_QUOTES);
$trl_filter   = htmlspecialchars($trl_L['t_filter'], ENT_QUOTES);
$trl_log      = htmlspecialchars($trl_L['t_log'], ENT_QUOTES);
$mytiles['tollroll']['column2'] = <<<EOT
<tbody title="TollRoll">
<tr><td><span class='tile-header'><span class='tile-header-left'><i class='icon-health f32'></i><div class='section'><h3 class='tile-header-main'>TollRoll</h3><span id='trl-sub' class='trl-sub'></span></div></span><span class='tile-header-right'><span class='tile-header-right-controls'><a id='trl-open' class='trl-open' href='#' target='_blank' rel='noopener noreferrer' hidden><i class='fa fa-fw fa-external-link control'></i></a><a href='/Settings/tollroll' title="{$trl_settings}"><i class='fa fa-fw fa-cog control'></i></a></span></span></span></td></tr>
<tr><td class='trl-td'><div id='trl' class='trl'><ul id='trl-rows' class='trl-rows'></ul><div id='trl-chips' class='trl-chips' role='group' aria-label="{$trl_filter}"></div><div id='trl-log' class='trl-log' role='log' aria-label="{$trl_log}" tabindex='0'></div></div></td></tr>
</tbody>
EOT;
?>
<link rel="stylesheet" href="<?autov('/plugins/tollroll/styles/tile.css')?>">
<script>window.TRL_T = <?=json_encode($trl_js, JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT)?>; window.TRL_LANG = <?=json_encode(preg_match('/^[a-z]{2}$/', $trl_lang) ? $trl_lang : 'en')?>;</script>
<script src="<?autov('/plugins/tollroll/scripts/tollroll-core.js')?>"></script>
<script src="<?autov('/plugins/tollroll/scripts/tile.js')?>"></script>
