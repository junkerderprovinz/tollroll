{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>junkerderprovinz/junkerderprovinz//renovate/base"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      "description": "The family's own module moves with its apps, by hand",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "github.com/junkerderprovinz/parleyport"
      ],
      "enabled": false
    }
  ]
}
